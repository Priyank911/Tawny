# Firebase web-app config (public project identifiers, not server credentials)
TAWNY_FIREBASE_API_KEY=
TAWNY_FIREBASE_PROJECT_ID=

# Google OAuth 2.0 credentials, created as an OAuth client of type "Desktop app".
# The client secret is embedded in the Electron main-process bundle at build time;
# it is recoverable from distributed desktop binaries and is not a server secret.
TAWNY_GOOGLE_CLIENT_ID=
TAWNY_GOOGLE_CLIENT_SECRET=
