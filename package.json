{
  "name": "voicerouter",
  "version": "0.1.16",
  "private": true,
  "description": "A hands-free voice layer for Windows: dictation, rewriting, image generation and voice-driven computer control.",
  "author": "Tawny",
  "desktopName": "com.tawny.desktop.desktop",
  "repository": {
    "type": "git",
    "url": "https://github.com/Priyank911/Tawny.git"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:native": "node scripts/build-native.mjs",
    "test:wake": "node scripts/test-wake.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "pnpm build:native && pnpm test:wake && pnpm build && electron-builder --win --publish never",
    "preview": "electron-vite preview"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "lucide-react": "0.468.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "xstate": "5.20.2",
    "zod": "4.1.5"
  },
  "devDependencies": {
    "@types/node": "24.5.2",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.4",
    "electron": "44.9.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "4.0.1",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
